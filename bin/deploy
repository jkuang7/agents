#!/usr/bin/env bash
# Link personal and vendored skills into the supported runtime homes, and
# Claude agent definitions into the Claude agents home.
#
#   deploy           link current skills and prune removed ones
#   deploy --check   report drift without changing anything
set -euo pipefail

agents_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
declare -a skills_sources=(
  "$agents_root/skills"
  "$agents_root/vendor/matt-pocock-skills"
)
check_only=false
[[ "${1:-}" == "--check" ]] && check_only=true
problems=0

declare -a skill_names=()
declare -a skill_paths=()
skill_count=0

declare -a runtime_homes=(
  "${CODEX_HOME:-$HOME/.codex}/skills"
  "${CLAUDE_HOME:-$HOME/.claude}/skills"
  "${AGENTS_HOME:-$HOME/.agents}/skills"
)

say() { printf '  %s\n' "$*"; }

is_managed_source() {
  local candidate="$1"
  local skills_source
  for skills_source in "${skills_sources[@]}"; do
    [[ "$candidate" == "$skills_source"/* ]] && return 0
  done
  return 1
}

for skills_source in "${skills_sources[@]}"; do
  [[ -d "$skills_source" ]] || continue
  for skill in "$skills_source"/*/; do
    [[ -f "$skill/SKILL.md" ]] || continue
    name="$(basename "$skill")"
    metadata_name="$(sed -n 's/^name:[[:space:]]*//p' "$skill/SKILL.md" | head -n 1)"
    metadata_name="${metadata_name%\"}"
    metadata_name="${metadata_name#\"}"
    metadata_name="${metadata_name%\'}"
    metadata_name="${metadata_name#\'}"

    if [[ -z "$metadata_name" ]]; then
      say "INVALID $skill/SKILL.md has no readable name"
      problems=$((problems + 1))
      continue
    fi
    if [[ "$metadata_name" != "$name" ]]; then
      say "INVALID $skill directory name must match skill name '$metadata_name'"
      problems=$((problems + 1))
      continue
    fi

    for ((index = 0; index < skill_count; index++)); do
      existing_name="${skill_names[$index]}"
      if [[ "$existing_name" == "$name" ]]; then
        say "DUPLICATE skill name '$name'"
        problems=$((problems + 1))
        continue 2
      fi
    done
    skill_names[$skill_count]="$name"
    skill_paths[$skill_count]="${skill%/}"
    skill_count=$((skill_count + 1))
  done
done

(( problems == 0 )) || exit 1

for runtime_home in "${runtime_homes[@]}"; do
  mkdir -p "$runtime_home"

  for entry in "$runtime_home"/*; do
    [[ -L "$entry" ]] || continue
    source="$(readlink "$entry")"
    is_managed_source "$source" || continue
    [[ -d "$source" ]] && continue

    if $check_only; then
      say "STALE   $entry"
      problems=$((problems + 1))
    else
      rm -- "$entry"
      say "pruned  $entry"
    fi
  done

  for ((index = 0; index < skill_count; index++)); do
    target="$runtime_home/${skill_names[$index]}"
    source="${skill_paths[$index]}"

    if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
      say "ok      $target"
    elif [[ -e "$target" || -L "$target" ]]; then
      say "CONFLICT $target"
      problems=$((problems + 1))
    elif $check_only; then
      say "MISSING $target"
      problems=$((problems + 1))
    else
      ln -s "$source" "$target"
      say "linked  $target"
    fi
  done
done

claude_agents_source="$agents_root/claude-agents"
claude_agents_home="${CLAUDE_HOME:-$HOME/.claude}/agents"
mkdir -p "$claude_agents_home"
for entry in "$claude_agents_home"/*.md; do
  [[ -L "$entry" ]] || continue
  source="$(readlink "$entry")"
  [[ "$source" == "$claude_agents_source"/* && ! -f "$source" ]] || continue
  if $check_only; then
    say "STALE   $entry"
    problems=$((problems + 1))
  else
    rm -- "$entry"
    say "pruned  $entry"
  fi
done
for source in "$claude_agents_source"/*.md; do
  [[ -f "$source" ]] || continue
  target="$claude_agents_home/$(basename "$source")"
  if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
    say "ok      $target"
  elif [[ -e "$target" || -L "$target" ]]; then
    say "CONFLICT $target"
    problems=$((problems + 1))
  elif $check_only; then
    say "MISSING $target"
    problems=$((problems + 1))
  else
    ln -s "$source" "$target"
    say "linked  $target"
  fi
done

# Claude Code always loads user rules, so routing needs no skill trigger.
route_source="$agents_root/skills/route/SKILL.md"
route_target="${CLAUDE_HOME:-$HOME/.claude}/rules/route.md"
if [[ -f "$route_source" ]]; then
  if [[ -L "$route_target" && "$(readlink "$route_target")" == "$route_source" ]]; then
    say "ok      $route_target"
  elif [[ -e "$route_target" || -L "$route_target" ]]; then
    say "CONFLICT $route_target"
    problems=$((problems + 1))
  elif $check_only; then
    say "MISSING $route_target"
    problems=$((problems + 1))
  else
    mkdir -p "$(dirname "$route_target")"
    ln -s "$route_source" "$route_target"
    say "linked  $route_target"
  fi
fi

# Codex loads only ~/.codex/AGENTS.md at start, so it gets the workspace
# AGENTS.md plus the route body as one generated file (a skill is read on demand).
workspace_agents="$agents_root/../AGENTS.md"
codex_agents="${CODEX_HOME:-$HOME/.codex}/AGENTS.md"
generated_marker='<!-- Generated by agents/bin/deploy from AGENTS.md and skills/route/SKILL.md. Do not edit. -->'
if [[ -f "$workspace_agents" && -f "$route_source" ]]; then
  generated="$(mktemp)"
  {
    printf '%s\n\n' "$generated_marker"
    cat "$workspace_agents"
    printf '\n'
    awk 'f>=2{print;next} /^---$/{f++}' "$route_source"
  } > "$generated"
  workspace_real="$(cd "$(dirname "$workspace_agents")" && pwd)/AGENTS.md"
  if [[ -f "$codex_agents" && ! -L "$codex_agents" ]] && cmp -s "$generated" "$codex_agents"; then
    say "ok      $codex_agents"
  elif [[ -L "$codex_agents" && "$(readlink "$codex_agents")" == "$workspace_real" ]] \
    || [[ -f "$codex_agents" && ! -L "$codex_agents" && "$(head -n 1 "$codex_agents")" == "$generated_marker" ]] \
    || [[ ! -e "$codex_agents" && ! -L "$codex_agents" ]]; then
    if $check_only; then
      say "STALE   $codex_agents"
      problems=$((problems + 1))
    else
      mkdir -p "$(dirname "$codex_agents")"
      rm -f -- "$codex_agents"
      cp "$generated" "$codex_agents"
      say "wrote   $codex_agents"
    fi
  else
    say "CONFLICT $codex_agents"
    problems=$((problems + 1))
  fi
  rm -f "$generated"
fi

if (( problems )); then
  printf 'deploy: %d issue(s)\n' "$problems" >&2
  exit 1
fi

$check_only && echo "deploy: all linked" || echo "deploy: complete"
